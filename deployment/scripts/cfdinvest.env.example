# Copy to /etc/cfdinvest/env, fill in, then:
#     sudo chown root:cfdinvest /etc/cfdinvest/env
#     sudo chmod 0640 /etc/cfdinvest/env
#
# This file holds secrets. It is not in the repository and must never be.
# The example is, with no values in it.

# Which account this deployment trades: virtual or live.
# Leave unset to keep the pre-separation shared tree -- see deployment/README.md
# before setting it on an install that already has runs.
CFD_ACCOUNT_MODE=virtual

# Where the lake lives.
CFD_DATA_ROOT=/var/lib/cfdinvest

# What the dashboard scales recommended sizes to.
CFD_ACCOUNT_BALANCE=2000

# Mail. The password is read from here and from nowhere else; it is not in the
# config file, not on a command line, and not in any log.
CFD_SMTP_HOST=smtp-relay.brevo.com
CFD_SMTP_PORT=587
CFD_SMTP_USER=
CFD_SMTP_PASSWORD=
CFD_SMTP_SENDER=hello@example.com
CFD_SMTP_RECIPIENTS=
CFD_SMTP_ENABLED=true

# Macro data.
FRED_API_KEY=

# Display.
CFD_DISPLAY_TZ=Europe/London
CFD_CURRENCY_SYMBOL=£
