# One pruning pass. Triggered by the timer, not enabled directly.
#
#   sudo systemctl enable --now cfdinvest-prune.timer
#   systemctl list-timers cfdinvest-prune
#
# Why this exists: every pipeline run writes an analysis frame of about
# 30 MB, and nothing removed it. The retention module was written and the
# `prune-runs` command existed, but no unit ever called it -- so the store
# grew by a run a day forever and the box reached 17% free.
#
# Both slimmed artefacts are rebuildable: the analysis frame from the lake,
# attribution from the trades. Nothing here removes something that cannot be
# produced again from what remains.

[Unit]
Description=cfdinvest run-artefact pruning
Documentation=https://github.com/brent-jenkins/cfdinvest
After=cfdinvest-pipeline.service

[Service]
Type=oneshot
User=cfdinvest
Group=cfdinvest
WorkingDirectory=/opt/cfdinvest
EnvironmentFile=/etc/cfdinvest/env

ExecStart=/opt/cfdinvest/.venv/bin/cfdinvest-schedule prune-runs

# It deletes, so it needs the artefact store writable and nothing else.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
# No network at all. Pruning reads the filesystem and nothing else, and a
# unit whose whole job is deletion should not be able to reach anywhere.
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=true

ReadOnlyPaths=/opt/cfdinvest
ReadWritePaths=/var/lib/cfdinvest

TimeoutStartSec=10min

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cfdinvest-prune
