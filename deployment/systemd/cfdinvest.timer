# The schedule for the analysis pass.
#
#   sudo systemctl enable --now cfdinvest.timer
#
# WHAT THIS USED TO BE
# --------------------
# Until 2026-09-11 this was a WATCHDOG rather than a schedule.
# `cfdinvest.service` was a resident loop that owned its own cadences, so a
# timer firing at it did nothing while it was healthy -- starting a running
# unit is a no-op -- and existed only to recover the one case
# `Restart=always` did not cover, a permanent stop after the start limit
# tripped.
#
# The service is now `Type=oneshot`: one tick, then it exits, so the leak
# cannot accumulate across a session. That makes this the thing that decides
# when the analysis runs.
#
# WHY ONE MINUTE
# --------------
# It is not the job cadence. Every job owns its own -- quotes every five
# minutes, signals every fifteen while a market is open, ingestion at 03:00,
# snapshots at 03:05 -- and `daemon.jobs_due` is a pure function of the
# clock and what ran last, read from disk. This interval only decides how
# often that question is ASKED, so it must be finer than the finest cadence
# and is otherwise free: a tick with nothing due takes 0.76 seconds and
# peaks at 127MB, measured on the box.
#
# `OnUnitInactiveSec` rather than `OnUnitActiveSec`: the gap is measured
# from when the last tick FINISHED, so a slow pass delays the next one
# instead of queueing behind itself.

[Unit]
Description=Run the cfdinvest analysis pass
Documentation=https://github.com/brent-jenkins/cfdinvest

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
AccuracySec=10s
# A tick missed while the box was down is not worth catching up on: the jobs
# are driven by what ran last, so the next tick works out what is owed
# anyway.
Persistent=false
Unit=cfdinvest.service

[Install]
WantedBy=timers.target
