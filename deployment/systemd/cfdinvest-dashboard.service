# The Streamlit dashboard, bound to localhost and reached only through Caddy.
#
#   sudo cp deployment/systemd/*.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cfdinvest-dashboard
#
# Logs go to the journal:  journalctl -u cfdinvest-dashboard -f

[Unit]
Description=cfdinvest dashboard (Streamlit)
Documentation=https://github.com/brent-jenkins/cfdinvest
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cfdinvest
Group=cfdinvest
WorkingDirectory=/opt/cfdinvest

# Secrets live here, owned by root and readable by the service user only.
# Never in the repository, never in this unit, never on a command line -- a
# password in ExecStart is a password in `ps`.
EnvironmentFile=/etc/cfdinvest/env

# --server.address 127.0.0.1 is the load-bearing argument. Without it
# Streamlit binds every interface and the dashboard is reachable directly on
# port 8501, going round Caddy and therefore round the basic auth.
ExecStart=/opt/cfdinvest/.venv/bin/streamlit run cfdinvest/ui/app.py \
    --server.address 127.0.0.1 \
    --server.port 8501 \
    --server.headless true \
    --browser.gatherUsageStats false

Restart=on-failure
RestartSec=10s

# Memory. Reading a run's artefacts costs far more than the files suggest --
# analysis.parquet is 30MB on disk and several times that in pandas -- and
# this box also runs other sites. Unbounded, the dashboard was
# OOM-killed mid-render and the kernel picked the victim by heuristic.
# Capped, the only thing that can die under memory pressure is the dashboard,
# which restarts and costs a reload rather than someone else's service.
MemoryHigh=700M
MemoryMax=1G

# The dashboard is read-only over the lake. It needs to write nothing except
# a scratch directory, so it is given nothing else.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Read-only: the code, and the lake. If the dashboard ever needs to write into
# the lake, that is a bug in the dashboard rather than a line to add here.
ReadOnlyPaths=/opt/cfdinvest
ReadOnlyPaths=/var/lib/cfdinvest
ReadWritePaths=/var/lib/cfdinvest/cache

# What the dashboard legitimately writes. Everything else under the data
# root stays read-only, which is the property worth keeping: a page that
# cannot overwrite a run artefact cannot corrupt the record it is showing.
#
# Each of these is a *record of what you did*, which is the dashboard's one
# job beyond rendering. Miss one and the page fails at the moment you use
# it -- sign-in half-worked for exactly this reason, and recording a trade
# failed after that.
#
#   auth          the credential store; without it the session-cookie
#                 secret cannot be persisted, so it is regenerated on every
#                 call and a token signed at login never verifies
#   confirmations what you actually placed, from Confirm Trades
#   journal       what you were thinking, from the Journal page
ReadWritePaths=/var/lib/cfdinvest/auth
ReadWritePaths=/var/lib/cfdinvest/confirmations
ReadWritePaths=/var/lib/cfdinvest/journal

# NOT writable, deliberately: accounts.json sits at the data root itself, so
# permitting it would mean making the whole root writable and losing the
# protection above. Creating or retiring an account changes where every
# other layer reads and writes -- that is an operator action on the host,
# not a dashboard one, and the Accounts page reports the refusal rather
# than appearing to succeed.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cfdinvest-dashboard

[Install]
WantedBy=multi-user.target
