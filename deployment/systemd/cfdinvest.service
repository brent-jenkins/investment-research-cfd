# The cfdinvest scheduler. One long-running loop that owns every scheduled
# job: live quotes every five minutes, ingestion at 03:00 UTC, the pipeline
# at 03:05, and the monitoring and risk snapshots after each run.
#
#   sudo systemctl enable --now cfdinvest.service
#   journalctl -u cfdinvest -f
#
# This SUPERSEDES cfdinvest-pipeline.timer and cfdinvest-monitor.timer.
# Disable both before enabling this, or two schedulers will write the same
# lake on different schedules:
#
#   sudo systemctl disable --now cfdinvest-pipeline.timer cfdinvest-monitor.timer
#
# It places no trades and calls no broker. See deployment/systemd/README.md.

[Unit]
Description=cfdinvest scheduler
Documentation=https://github.com/brent-jenkins/cfdinvest
After=network-online.target
Wants=network-online.target
# Refuse to start alongside the units this replaces, rather than trusting
# whoever deploys to have read the note above. Two schedulers writing one
# lake is the failure this guards.
Conflicts=cfdinvest-pipeline.service cfdinvest-monitor.service

[Service]
Type=simple
User=cfdinvest
Group=cfdinvest
WorkingDirectory=/opt/cfdinvest
EnvironmentFile=/etc/cfdinvest/env

ExecStart=/opt/cfdinvest/.venv/bin/cfdinvest-schedule daemon

Restart=always
RestartSec=5

# Memory. The ceiling exists to protect the *neighbours*. This box also runs
# other sites, and an unbounded pipeline spike would have the kernel
# choosing a victim by heuristic rather than by intent. Capped, the only
# thing that can die under memory pressure here is this service, which is
# restartable. That reasoning is unchanged and still right.
#
# RESIZED 2026-09-09, after the old limits stalled the daemon through a live
# session. Two things had gone stale and one was never true.
#
#   * The old figures were sized for a 4GB box that was OOM-killed four
#     times during the first deployment. The box has 8GB now (7747MB) and
#     nobody revisited them, so the service was confined to 23% of a machine
#     twice the size it was written for.
#   * They were sized for "43 instruments over eight years of DAILY bars".
#     The pipeline now runs 55 series (50 names plus 5 FX pairs) on HOURLY
#     bars, which is a far larger frame.
#   * "MemoryHigh throttles and pushes pages to swap first" was believed to
#     be graceful degradation. IT IS NOT. `memory.high` sleeps the task on
#     every allocation past the limit, proportional to the overage, and a
#     process meaningfully over it never finishes anything again.
#
# On 2026-09-09 the pipeline peaked at 1801MB against MemoryHigh=1800M. One
# megabyte over, 39,932 throttle events, and the daemon sat in
# mem_cgroup_handle_over_high for 45 minutes of an open session. It never
# reached MemoryMax, so it was never killed -- `max` events were ZERO --
# which meant Restart=always never fired, cfdinvest.timer saw an active
# unit, the monitoring snapshot reported healthy, and the account silently
# stopped dealing. The safety mechanism prevented the safety mechanism from
# working: the comment above argues the service is safe because its FAILURE
# is reported, and throttling means it never fails.
#
# MEASURED, on the 8GB box: every other service totals about 1,100MB
# (journald 457, the dashboard 375, rsyslog 87, caddy 59, the rest under 40
# each). The pipeline peaks at 1801MB -- and that reading was taken WHILE
# THROTTLED, so the unconstrained peak is higher and this sizing assumes it
# is. 3G high leaves roughly 60% headroom over the measured peak; 4G max
# plus 1.1G of neighbours is 5.1G of 7.7G, leaving the kernel its page
# cache.
#
# The gap between the two is deliberate and now small enough to be crossed.
# A transient spike is reclaimed at MemoryHigh; a genuine runaway reaches
# MemoryMax and is KILLED, which is the loud failure the whole design
# assumed it would get. Sizing MemoryHigh at the normal peak, as before, put
# the process permanently in the throttle zone -- the one state that is
# neither working nor dead.
MemoryHigh=3G
MemoryMax=4G
# Swap is bounded because it was not. The stalled daemon consumed all 2047MB
# of the box's swap, degrading exactly the neighbours these limits protect,
# and thrashing made the stall harder to diagnose rather than easier. 512M
# absorbs a spike; it cannot absorb a leak, which is the point.
MemorySwapMax=512M
# A crash loop against a vendor endpoint is worse than a stopped daemon:
# it looks like it is working. Five failures in five minutes stops it, and
# the monitoring snapshot then reports stale quotes and a stale lake.
StartLimitIntervalSec=300
StartLimitBurst=5

# Binds nothing. The dashboard is a separate unit and this must never
# acquire a port -- an accidental listener behind Caddy's basic auth would
# answer the internet directly.
PrivateNetwork=false

# It writes: run artefacts, scheduler state, snapshots, the quote file.
# Everything else stays read-only.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

ReadOnlyPaths=/opt/cfdinvest
ReadWritePaths=/var/lib/cfdinvest

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cfdinvest

[Install]
WantedBy=multi-user.target
