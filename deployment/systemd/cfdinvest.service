# The cfdinvest analysis pass. ONE TICK, then it exits.
#
#   sudo systemctl enable --now cfdinvest.timer
#   journalctl -u cfdinvest -f
#
# It places no trades and calls no broker. Dealing is
# `cfdinvest-dealer.service`, on its own five-minute timer.
#
# WHAT THIS USED TO BE, AND WHY IT CHANGED
# ----------------------------------------
# Until 2026-09-11 this was `Type=simple` with `Restart=always`: one
# long-running loop that owned every scheduled job and never exited. That
# design is what made the leak fatal rather than untidy.
#
# The daemon leaked about 360MB an hour -- measured from a clean start,
# every ten-minute sample higher than the last, 900MB at 17:23 to 1796MB at
# 19:53, linear. A ratchet plateaus; this did not. Running the pipeline
# three times in one process retains +511MB, +23MB, +6MB, converging to
# nothing, so `run_pipeline` is not the leak; it is somewhere in the
# recurring jobs around it and it has NOT been identified.
#
# **A process that exits cannot accumulate.** Sixteen hours of uptime is
# what turned a 360MB/hour leak into the 5.7GB that could not allocate a
# correlation panel and stalled the account through a whole trading session.
# One tick is seconds. This bounds the leak structurally rather than waiting
# to find it, and it holds whatever the cause turns out to be.
#
# The scheduling did not move: `daemon.jobs_due` is pure and reads what ran
# last from `persist.scheduler_state` on disk, so a tick that starts cold
# computes exactly what the resident loop would have. `--max-ticks 1` was
# built for tests and dry runs and is now a PRODUCTION path -- do not delete
# it as test-only scaffolding.
#
# Measured on the box on 2026-09-11: a tick with nothing due takes 0.76s and
# peaks at 127MB.
#
# **It claims only two jobs, since the scheduler split of 2026-09-12:**
#
#     run-intraday
#     record-spreads
#
# This is the HEAVY unit -- the pipeline that produces the run the dealer
# reads. Quotes, ingestion and the daily housekeeping each moved to their own
# unit, because while they shared this process they queued behind it. The
# subsets must partition JOBS; tests/test_jobs_are_partitioned.py fails the
# build on a job claimed twice or claimed by nobody.
#
# If a tick overruns its interval, systemd will not start a second while the
# first is still running. That self-throttling is deliberate and replaces
# the loop's own sequencing.

[Unit]
Description=cfdinvest analysis pass
Documentation=https://github.com/brent-jenkins/cfdinvest
After=network-online.target
Wants=network-online.target
# The PIPELINE service would run ingestion a second time on its own
# schedule against one lake, so it genuinely conflicts.
#
# **The MONITOR service does not, and lumping it in here is why two silent
# stalls went unreported.** `cfdinvest-monitor.service` runs
# `cfdinvest-schedule monitor --alert`: it reads, it alerts, it ingests
# nothing, and it finishes in about a second. Conflicting with it meant the
# monitor timer could not be enabled without stopping the dealer every
# thirty minutes -- so it was left disabled, and the one check that detects
# this process hanging was left running INSIDE it, on a daily snapshot at
# 03:05 when the market is shut and `market_open` is always False.
#
# It failed exactly as that arrangement predicts. On 2026-09-09 the daemon
# was throttled into a 45-minute stall and nothing said so. On 2026-09-11 it
# stalled for NINETEEN HOURS -- from 19:43 the previous evening through most
# of a trading session -- and nothing said so.
Conflicts=cfdinvest-pipeline.service

# A failing tick must never stop the timer. The old unit set
# StartLimitBurst=5 in 300s and systemd then gave up PERMANENTLY, which is
# the failure mode this whole file is about: the scheduler stayed down until
# somebody noticed. One tick a minute is not a hot loop even when every one
# of them fails, the failure is in the journal, and
# `cfdinvest-monitor.service` alerts on it from outside.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=cfdinvest
Group=cfdinvest
WorkingDirectory=/opt/cfdinvest
EnvironmentFile=/etc/cfdinvest/env

ExecStart=/opt/cfdinvest/.venv/bin/cfdinvest-schedule daemon --max-ticks 1     --only run-intraday,record-spreads

# A tick that hangs is killed rather than left to wedge the timer. The
# longest legitimate tick is a full intraday run, measured at 26 seconds
# after correlations were removed from the analysis frame; the daily ingest
# is slower and vendor-bound. Fifteen minutes is generous against both and
# far short of the nineteen hours a wedged pass cost.
TimeoutStartSec=900

# Memory. The ceiling exists to protect the *neighbours*. This box also runs
# other sites, and an unbounded spike would have the kernel choosing a
# victim by heuristic rather than by intent.
#
# **MemoryHigh is deliberately NOT set, and that is the lesson of
# 2026-09-09.** `memory.high` does not degrade gracefully: it sleeps the
# task on every allocation past the limit, proportional to the overage, and
# a process meaningfully over it never finishes anything again. The pipeline
# peaked at 1801MB against MemoryHigh=1800M -- one megabyte over, 39,932
# throttle events, 45 minutes in mem_cgroup_handle_over_high during an open
# session. It never reached MemoryMax, so it was never killed, so
# Restart=always never fired and the unit stayed `active` while the account
# silently stopped dealing. The safety mechanism prevented the safety
# mechanism from working.
#
# So there is one limit and crossing it KILLS, which is the loud failure the
# design assumes it will get. Sized against the measured peak: 941MB for a
# full intraday run after correlations were removed, 127MB for an idle tick.
MemoryMax=2G
# Swap is bounded because it was not. The stalled daemon consumed all 2047MB
# of the box's swap, degrading exactly the neighbours these limits protect,
# and thrashing made the stall harder to diagnose rather than easier.
MemorySwapMax=512M

# Binds nothing. The dashboard is a separate unit and this must never
# acquire a port -- an accidental listener behind Caddy's basic auth would
# answer the internet directly.
PrivateNetwork=false

# It writes: run artefacts, scheduler state, snapshots, the quote file.
# Everything else stays read-only.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

ReadOnlyPaths=/opt/cfdinvest
ReadWritePaths=/var/lib/cfdinvest

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cfdinvest

# No [Install] section. This unit is started by cfdinvest.timer and by
# nothing else; a WantedBy=multi-user.target here would start one stray tick
# at boot, outside the schedule, for no reason.
