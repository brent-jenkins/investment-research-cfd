# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_32_character_fred_api_key_here

# --- Optional overrides (these beat config/config.toml) ---
# CFD_CONFIG_FILE=config/config.toml
# CFD_DATA_ROOT=D:/market-data/cfdinvest
# CFD_TICKERS=SPY,QQQ,GLD,EURUSD=X
# CFD_INTERVAL=1d
# CFD_START=2010-01-01
# CFD_END=
# CFD_FRED_SERIES=DGS10,T10Y2Y,VIXCLS
# CFD_FRED_OBSERVATION_START=1990-01-01
# CFD_LOG_LEVEL=INFO
# CFD_LOG_FILE=logs/cfdinvest.log
# CFD_PARQUET_COMPRESSION=zstd
