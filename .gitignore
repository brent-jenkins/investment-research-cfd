# ---------------------------------------------------------------- secrets --
# NEVER commit real credentials. .env holds the live FRED API key.
.env
.env.*
# ...but the checked-in template carries no secrets and README references it,
# so it is deliberately re-included. Order matters: this must follow .env.*
!.env.example

# ------------------------------------------------------------ Python bits --
__pycache__/
*.py[cod]
*$py.class
*.so

# --------------------------------------------------------------- packaging --
build/
dist/
*.egg-info/
*.egg
.eggs/

# ------------------------------------------------------ virtual environments --
.venv/
venv/
env/
ENV/
.python-version
.conda/

# ---------------------------------------------------------- data artifacts --
# The Parquet lake is regenerated by the ingestion layer; it is derived data,
# not source, and would bloat the repo.
data/
parquet/
logs/
*.parquet
*.parquet.tmp
*.json.tmp

# ------------------------------------------------------- test / tool caches --
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ------------------------------------------------------------- notebooks --
.ipynb_checkpoints/

# --------------------------------------------------------- editors / IDEs --
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------- OS --
.DS_Store
Thumbs.db
desktop.ini
